#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";
        timeout-ms = <50>; // How fast the keys must be pressed together

        // This is your specific combo
        toggle_nav_combo {
            timeout-ms = <50>;
            key-positions = <0 40>; // Replace with the indices of your two keys
            bindings = <&tog 2>;
        };
        combo_esc {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp ESC>;
        };
        combo_esc {
            timeout-ms = <50>;
            key-positions = <12 19>;
            bindings = <&kp ESC>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp TAB    &kp SQT   &kp COMMA  &kp DOT   &kp P     &kp Y        &kp F      &kp G          &kp C     &kp R  &kp L  &kp BSPC
&kp RCTRL  &kp A     &kp O      &kp E     &kp U     &kp I        &kp D      &kp H          &kp T     &kp N  &kp S  &kp RET
&kp LSHFT  &kp SEMI  &kp Q      &kp J     &kp K     &kp X        &kp B      &kp M          &kp W     &kp V  &kp Z  &kp RSHFT
                                &kp LALT  &kp LGUI  &kp SPACE    &kp SPACE  &mo 1          &kp RGUI
            >;
        };
/*
        reversebase {
            bindings = <
&kp BSPC    &kp L   &kp R  &kp C   &kp G     &kp F        &kp Y      &kp P          &kp DOT     &kp COMMA  &kp SQT  &kp TAB
&kp RET  &kp S     &kp N      &kp T     &kp H     &kp D        &kp I      &kp U          &kp E     &kp O  &kp A  &kp RTCRL
&kp LSHFT  &kp Z  &kp V      &kp W     &kp M     &kp B        &kp X      &kp K          &kp J     &kp Q  &kp SEMI  &kp RSHFT
                                &kp LALT  &kp LGUI  &kp SPACE    &kp SPACE  &kp LC(LSHFT)  &kp RGUI
            >;
        };
*/

        symbols {
            bindings = <
&kp GRAVE  &kp N1        &kp N2      &kp N3         &kp N4        &kp N5       &kp N6     &kp N7     &kp N8    &kp N9    &kp N0    &kp BSPC
&kp RCTRL  &trans        &trans      &trans         &trans        &trans       &trans     &trans     &trans    &trans    &trans    &kp MINUS
&kp LSHFT  &none     &kp EQUAL    &kp DOT        &kp LBKT      &kp LBRC     &kp RBRC   &kp RBKT   &kp FSLH  &kp BSLH  &trans        &kp RSHFT
                                     &kp LALT       &kp LGUI      &kp SPACE    &kp SPACE  &none      &kp RGUI
            >;
        };

        navigation {
            bindings = <
&none  &msc SCRL_UP    &mmv MOVE_UP    &msc SCRL_DOWN   &none  &none    &none     &kp UP  &none  &none  &none  &none
&none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &none    &kp LEFT     &kp DOWN  &kp RIGHT  &none  &none  &none
&none  &msc SCRL_LEFT  &none           &msc SCRL_RIGHT  &none  &none    &none     &none  &none  &none  &none  &none
                                       &mkp MB5            &mkp MB4  &mkp MB1 &mkp MB2  &mkp MB3  &tog 0
            >;
        };
    };
};
