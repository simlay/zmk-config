#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp TAB    &kp SQT   &kp COMMA  &kp DOT   &kp P     &kp Y        &kp F      &kp G          &kp C     &kp R  &kp L  &kp BSPC
&kp RCTRL  &kp A     &kp O      &kp E     &kp U     &kp I        &kp D      &kp H          &kp T     &kp N  &kp S  &kp RET
&kp LSHFT  &kp SEMI  &kp Q      &kp J     &kp K     &kp X        &kp B      &kp M          &kp W     &kp V  &kp Z  &kp RSHFT
                                &kp LALT  &kp LGUI  &kp SPACE    &kp SPACE  &kp RSE  &kp RGUI
            >;
        };

        symbols {
            bindings = <
&kp TAB    &kp EXCL  	 &kp AT      &kp POUND      &kp DLLR      &kp PRCNT    &kp CARET  &kp AMPS   &kp STAR  &kp LPAR  &kp RPAR  &kp BSPC
&kp RCTRL  &kp N1        &kp N2      &kp N3         &kp N4        &kp N5       &kp N6     &kp N7     &kp N8    &kp N9    &kp N0    &kp RET
&kp LSHFT  &kp SQT       &kp COMMA   &kp DOT        &kp LBKT      &kp LBRC     &kp RBRC   &kp RBKT   &kp FSLH  &kp BSLH  &kp FSLH  &kp RSHFT
                                     &kp LALT       &kp LGUI      &kp SPACE    &kp SPACE  &kp LSHFT  &kp RGUI
            >;
        };

        navigation {
            bindings = <
&none  &msc SCRL_UP    &mmv MOVE_UP    &msc SCRL_DOWN   &none  &none    &none  &none  &none  &none  &none  &none
&none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &none    &none  &none  &none  &none  &none  &none
&none  &msc SCRL_LEFT  &none           &msc SCRL_RIGHT  &none  &none    &none  &none  &none  &none  &none  &none
                                       &none            &none  &mkp MB1 &mkp MB2  &none  &none
            >;
        };
    };
};
