reversesymbols {
    bindings = <
    &kp TILDE    &kp N0       &kp N9      &kp N8      &kp N7             &kp N6       &kp N5         &kp N4            &kp N3      &kp N2          &kp N1      &kp GRAVE
    &kp RCTRL    &kp RPAR     &kp LPAR    &kp STAR    &kp AMPS           &kp CARET    &kp PERCENT    &kp DOLLAR        &kp HASH    &kp AT          &kp EXCL    &kp LCTRL
    &kp MINUS    &kp EQUAL    &kp PIPE    &kp BSLH    &kp RIGHT_BRACE    &kp RBKT     &kp LBKT       &kp LEFT_BRACE    &kp FSLH    &kp QUESTION    &kp PLUS    &kp UNDERSCORE
                                                    &td_to_4         &trans             &kp SPACE     &kp SPACE    &trans     &td_to_2
    >;
}
